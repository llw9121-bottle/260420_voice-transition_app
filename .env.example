# DashScope API 配置
# 获取 API Key: https://help.aliyun.com/zh/dashscope/developer-reference/acquisition-and-configuration-of-api-key
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 百炼 LLM API 配置（可选，默认使用 DASHSCOPE_API_KEY）
BAILIAN_API_KEY=your_bailian_api_key_here

# DashScope 区域
DASHSCOPE_REGION=cn-beijing

# 百炼业务空间 ID（可选，推荐）
# 在百炼控制台 -> 业务空间管理 -> API Host 获取，形如 llm-xxxxxxxxxxxx
# 填写后使用专属域名；留空则使用公共域名
# DASHSCOPE_WORKSPACE_ID=llm-xxxxxxxxxxxx

# 可选：显式覆盖服务地址（一般无需填写）
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# DASHSCOPE_WS_BASE_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime

# 代理模式：system(默认，使用系统/环境代理) / direct(直连) / manual(手动代理)
# DASHSCOPE_PROXY_MODE=system
# DASHSCOPE_PROXY_URL=http://127.0.0.1:7890

# 百炼文本生成模型（默认 qwen-plus；行为分析可改为 qwen-max 提升召回）
# 需要长期复现时，优先使用带日期的快照模型名，避免滚动别名升级
# BAILIAN_MODEL=qwen-plus

# 固定随机种子，降低同一输入的采样漂移（不能保证逐字一致）
# BAILIAN_SEED=42

# 是否在日志中记录原始 LLM 响应/引文（默认 false，日志仅记录长度）
# LOG_LLM_RAW=false

# 是否在日志中记录完整 ASR 转写文本（默认 false，避免录音内容落盘）
# LOG_ASR_TEXT=false

# 输出目录
OUTPUT_DIR=./output
